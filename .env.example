# Twitter (use cookies - get from x.com DevTools > Application > Cookies)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_GUEST_ID=
TWITTER_TWID=
# Or use username/password (may be blocked by Cloudflare)
TWITTER_USERNAME=
TWITTER_PASSWORD=

# Bluesky
BLUESKY_USERNAME=yourhandle.bsky.social
BLUESKY_PASSWORD=your-app-password

# Target Twitter user to mirror (without @)
TARGET_USER=

# Check interval in seconds (default: 300)
CHECK_INTERVAL=300

# Mirror the target account's Twitter pin to Bluesky (uses state.json mappings)
ENABLE_PIN_MIRROR=true
# Hours between pin checks if the pin has not changed (0 = check every loop)
PIN_CHECK_INTERVAL_HOURS=2

# Translation (optional)
ENABLE_TRANSLATION=false
TRANSLATION_FROM=es
TRANSLATION_TO=en
TRANSLATOR_RAPIDAPI_KEY=

# Auto-update (optional)
AUTO_UPDATE=true
# Seconds
UPDATE_CHECK_INTERVAL=86400 # 1 day

# Webhooks / push notifications (optional — Chegou only for now)
# Paste your unique URL from the Chegou app (https://chegou.dev)
WEBHOOK_URL=
# Channel label in the Chegou app (e.g. bot, monitoring, ci)
WEBHOOK_CHANNEL=bot
# Hours between "still online" status pings (0 = disable periodic status)
# Errors/auth/upload failures and startup still notify when WEBHOOK_URL is set
WEBHOOK_STATUS_INTERVAL_HOURS=6